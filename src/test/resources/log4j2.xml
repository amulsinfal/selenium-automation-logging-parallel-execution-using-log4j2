<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">
	<Appenders>
		<Routing name="RoutingAppender">
			<Routes pattern="$${ctx:logFileName}">
				<Route>
					<RollingFile name="RollingFile-${ctx:logFileName}"
						fileName="logs/${ctx:logFileName}.log"
						filePattern="logs/${ctx:logFileName}-%d{MM-dd-yyyy-HH-mm}.log.gz">
						<PatternLayout
							pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c{2}::%M::%L - %msg%n" />
						<Policies>
							<TimeBasedTriggeringPolicy />
							<SizeBasedTriggeringPolicy size="5MB" />
						</Policies>
					</RollingFile>
				</Route>
			</Routes>
		</Routing>
		<Console name="Console" target="STDOUT">
			<PatternLayout
				pattern="[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c{2}::%M::%L - %msg%n" />
		</Console>
	</Appenders>
	<Loggers>
		<Root level="debug">
			<AppenderRef ref="RoutingAppender" />
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>
